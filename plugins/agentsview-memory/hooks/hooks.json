{
  "description": "Keep the selected AgentsView memory target available when a session starts or resumes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
