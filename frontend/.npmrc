# npm 12 refuses git dependencies by default. Allow only the ones declared
# directly in package.json (@kenn-io/kit-ui), not transitive ones.
allow-git=root

# npm installs only versions published at least 7 days ago, matching the
# shared Renovate release-age preset in kenn-io/actions. Needs npm 11.10 or
# later.
min-release-age=7
