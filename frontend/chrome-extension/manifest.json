{
  "manifest_version": 3,
  "name": "AgentsView Claude.ai Sync",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "permissions": [
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "key": ""
}
