{
  "name": "agentsview-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "generate:api": "node scripts/generate-api-client.mjs",
    "check:api": "node scripts/generate-api-client.mjs --check",
    "check:api:if-available": "node scripts/generate-api-client.mjs --check-if-go-available",
    "preview": "vp preview",
    "precheck": "npm run i18n:compile && npm run check:api:if-available",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:kit-ui": "kit-ui-check src",
    "test": "vp test run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "git+https://github.com/kenn-io/kit-ui.git#b4227114b3f6cc5edaa9a7ebf6cab7dbec2f527e",
    "@lucide/svelte": "1.34.0",
    "@tanstack/virtual-core": "3.17.8",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-time": "3.1.0",
    "dompurify": "3.4.14",
    "layerchart": "2.3.0",
    "marked": "18.0.11",
    "mermaid": "11.17.2",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.20.2",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "jsdom": "29.1.1",
    "openapi-typescript-codegen": "^0.31.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "packageManager": "npm@12.0.2"
}
