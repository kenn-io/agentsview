{
  "name": "agentsview-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "generate:api": "node scripts/generate-api-client.mjs",
    "check:api": "node scripts/generate-api-client.mjs --check",
    "check:api:if-available": "node scripts/generate-api-client.mjs --check-if-go-available",
    "preview": "vp preview",
    "precheck": "npm run i18n:compile && npm run check:api:if-available",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:kit-ui": "kit-ui-check src",
    "fmt": "vp fmt",
    "precheck:vp": "npm run i18n:compile",
    "check:vp": "vp check",
    "test": "vp test run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "git+https://github.com/kenn-io/kit-ui.git#a6bfaffcfb05da95b90600c95daf7272cfaf0196",
    "@lucide/svelte": "1.61.0",
    "@tanstack/virtual-core": "3.19.7",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "dompurify": "3.4.17",
    "eventsource": "^5.0.0",
    "eventsource-parser": "^4.0.0",
    "layerchart": "2.8.1",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.20.2",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "orval": "8.44.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "0.19.0",
    "mermaid": "$mermaid",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "$vitest"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "npm@12.2.1"
}
