{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "gomod", "npm"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "github-actions-dependencies",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMinor": false,
      "separateMultipleMajor": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-dependencies",
      "postUpdateOptions": ["gomodUpdateImportPaths", "gomodTidy"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "description": [
        "Update Vite+, its Vite alias, and Vitest together so npm can regenerate the lockfile."
      ],
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vitest",
        "@vitest/**"
      ],
      "groupName": "Vite+ toolchain",
      "groupSlug": "vite-plus-toolchain"
    },
    {
      "description": [
        "Vite+ selects these bundled versions. Update direct pins to match Vite+ toolchain upgrades, never independently."
      ],
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vite",
        "rolldown",
        "tsdown",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": [
        "rawcapture passes modernc.org/sqlite's *libc.TLS to sqlite3 calls, so libc must match the major version modernc.org/sqlite requires (v1). libc v2 also ships no Windows port."
      ],
      "matchManagers": ["gomod"],
      "matchPackageNames": ["modernc.org/libc"],
      "allowedVersions": "<2"
    },
    {
      "description": ["kenn-io releases open right away: no release-age wait and no weekly window."],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies",
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    }
  ]
}
