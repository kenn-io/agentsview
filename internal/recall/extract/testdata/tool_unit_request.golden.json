{
	"messages": [
		{
			"role": "system",
			"content": "action prompt"
		},
		{
			"role": "user",
			"content": "[1] ASSISTANT:\nI'll look at the existing workflows first.\n\n[2] ASSISTANT:\nListing the workflow directory.\n[Bash: ls .github/workflows]\n\n[3] ASSISTANT:\nThere is no deploy workflow yet. I suggest adding .github/workflows/deploy.yml with staging and production jobs."
		}
	],
	"response_format": {
		"type": "json_schema",
		"json_schema": {
			"name": "session_readout",
			"strict": true,
			"schema": {
				"required": [
					"entries"
				],
				"additionalProperties": false,
				"type": "object",
				"properties": {
					"entries": {
						"type": "array",
						"maxItems": 100,
						"items": {
							"type": "object",
							"properties": {
								"entities": {
									"type": "array",
									"maxItems": 50,
									"items": {
										"type": "string",
										"maxLength": 200
									}
								},
								"type": {
									"type": "string",
									"enum": [
										"fact",
										"decision",
										"procedure",
										"warning",
										"preference",
										"open_question"
									]
								},
								"title": {
									"type": "string",
									"minLength": 1,
									"maxLength": 500
								},
								"body": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": [
								"type",
								"title",
								"body",
								"entities"
							],
							"additionalProperties": false
						}
					}
				}
			}
		}
	},
	"model": "test-model",
	"max_tokens": 100,
	"temperature": 0
}
